#!/usr/bin/env bash

USAGE="Usage: $(basename "$0") [options] <target>
    Wrapper around ppb that auto-selects the most recent file in a directory.
    Useful for quickly uploading screenshots or other auto-saved files.
    Run 'ppb -h' for full argument documentation.
"

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    echo -e "$USAGE"
    exit 0
fi

TARGET="${*: -1}"
if [ -z "${TARGET}" ]; then
    echo "Please specify a target."
    exit 1
fi

if [[ -d "${TARGET}" ]]; then
    TARGET="${TARGET}/$(ls -rt "${TARGET}" | tail -n 1)"
fi

ppb "${@:1:$#-1}" "${TARGET}"
